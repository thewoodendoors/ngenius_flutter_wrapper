<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Required by the Google Pay API; merged into the host app's manifest. -->
        <meta-data
            android:name="com.google.android.gms.wallet.api.enabled"
            android:value="true" />

        <!-- The SDK declares its card screen without a theme, so it inherits the
             host application's. A Flutter app's theme is not an AppCompat one and
             the screen then dies in onCreate ("You need to use a Theme.AppCompat
             theme"). Give it the plugin's AppCompat theme; the manifest merger adds
             the attribute to the SDK's declaration. -->
        <activity
            android:name="payment.sdk.android.payments.PaymentsActivity"
            android:theme="@style/Theme.NgeniusFlutterWrapper.Payments" />

        <!-- The way back from N-Genius's hosted payment page, which the app opens in a
             Custom Tab on top of itself: the merchant's return page links to
             "<applicationId>.pay://return". The activity brings the running app back to
             the front and closes the tab; it reads nothing from the link and keeps it
             from the other SDKs in the app (PayReturnActivity). -->
        <activity
            android:name="com.thewoodendoors.ngenius_flutter_wrapper.PayReturnActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}.pay" />
            </intent-filter>
        </activity>
    </application>
</manifest>
